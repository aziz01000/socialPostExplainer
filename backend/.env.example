# Environment configuration for Contextual Post Explainer

# API Configuration
DEBUG=false
API_TITLE="Contextual Post Explainer"
API_VERSION="1.0.0"

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM Router Configuration
LLM_PROVIDER=openai

# Vector Store Configuration
FAISS_INDEX_PATH=./data/faiss_index.pkl
EMBEDDINGS_CACHE_PATH=./data/embeddings_cache.json

# Phoenix Configuration
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=contextual-post-explainer
PHOENIX_ENDPOINT=http://localhost:6006

# Retrieval Configuration
TOP_K_DOCUMENTS=5
RERANK_TOP_K=3

# Guardrails Configuration
ENABLE_INPUT_MODERATION=true
ENABLE_OUTPUT_MODERATION=true

# Image Understanding
ENABLE_IMAGE_UNDERSTANDING=true
MAX_IMAGE_SIZE_MB=10
