# OpenAI Configuration
OPENAI_API_KEY=sk-...

# API Configuration
DEBUG=false
API_TITLE="Contextual Post Explainer"

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# Retrieval
TOP_K_DOCUMENTS=5
RERANK_TOP_K=3

# Guardrails
ENABLE_INPUT_MODERATION=true
ENABLE_OUTPUT_MODERATION=true

# Observability
PHOENIX_ENABLED=true
