# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Social Media API Keys (Optional - uses mock data if not configured)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=

# News API Keys (Optional - uses mock data if not configured)
# NewsData.io - Free with optional key (https://newsdata.io)
NEWSDATA_API_KEY=pub_3fc8da999693412488974f1c70d8aa0b
# NewsAPI.org - Requires free signup (https://newsapi.org)
NEWSAPI_API_KEY=
# The Guardian - Requires free signup (https://www.theguardian.com/open-platform)
GUARDIAN_API_KEY=

# API Configuration
DEBUG=false
API_TITLE="Contextual Post Explainer"

# LLM Configuration
# Options: "openai" or "gemini"
LLM_PROVIDER=gemini

# Retrieval
TOP_K_DOCUMENTS=5
RERANK_TOP_K=3
# Vector DB: fetch more candidates, then keep only those above relevance threshold (omit vector_db if none relevant)
VECTOR_DB_INITIAL_K=20
VECTOR_DB_RELEVANCE_THRESHOLD=0.45

# Guardrails
ENABLE_INPUT_MODERATION=true
ENABLE_OUTPUT_MODERATION=true

# Observability (Arize Phoenix - every LLM call is traced)
PHOENIX_ENABLED=true
# Optional: project name in Phoenix UI
PHOENIX_PROJECT_NAME=contextual-post-explainer
# Optional: collector URL (default: http://localhost:6006).
# Run Phoenix UI with: make phoenix  (Docker; do not pip install arize-phoenix in app venv)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# Optional: API key for Phoenix Cloud / secured collector
# PHOENIX_API_KEY=
LOG_LEVEL=INFO
